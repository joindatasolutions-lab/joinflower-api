# Copia este archivo como .env y ajusta los valores reales.
# La app usa PostgreSQL por defecto en app/database.py.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=joinflower
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Alternativa: define una URL completa y se ignoraran las variables anteriores.
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/joinflower

# IMPORTANTE: el nombre real que lee el codigo es JWT_SECRET (app/core/security.py),
# no JWT_SECRET_KEY. Si se configura con el nombre equivocado, la app cae en el
# default inseguro hardcodeado en el codigo sin avisar. Ver pendientes/Mejoras/
# jwt-secret-produccion-sin-configurar.md para el hallazgo detallado.
JWT_SECRET=change-this-secret
# IMPORTANTE: la instancia de Cloud SQL de produccion (tier db-f1-micro) solo
# soporta max_connections=25 en Postgres. Con Cloud Run escalando hasta
# maxScale=10 instancias, cada una con su propio pool, hay que multiplicar
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x num_instancias y que quede bien por
# debajo de 25 (dejando margen para cloudsqladmin y conexiones manuales).
# Valores anteriores (8+4=12 por instancia) permitian hasta 120 conexiones
# teoricas y causaban "QueuePool limit reached" en rafagas de trafico reales
# (ver pendientes/Mejoras/pool-conexiones-agotado.md). No subir esto sin
# antes subir el tier de Cloud SQL o agregar PgBouncer.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# Cache (app/services/cache.py) - fase 1: solo memoria, Redis-ready para fase 2.
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL=300
CACHE_DEBUG=false
# Overrides opcionales por cache (segundos). Si no se definen, usan CACHE_DEFAULT_TTL.
# CACHE_TTL_BARRIOS=300
# CACHE_TTL_CATALOGO=300
# CACHE_TTL_EMPRESA_CONFIG=300

# Rate limiting (app/middlewares/rate_limit.py) - fase 1: memoria por instancia, Redis-ready para fase 2.
# Cloud Run del servicio join-flower escala hasta maxScale=10, por eso el limite de login
# se bajo de 30/minute a 10/minute (10 instancias x 30/min = 300/min efectivos era demasiado).
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
# Overrides opcionales (formato "N/minute"). Si no se definen, usan el default en el codigo.
# RATE_LIMIT_PEDIDOS_LIST=100/minute
# RATE_LIMIT_PEDIDO_CHECKOUT=60/minute
# RATE_LIMIT_PEDIDO_MANUAL=60/minute
# RATE_LIMIT_PEDIDO_CREAR=60/minute
