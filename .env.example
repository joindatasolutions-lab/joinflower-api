# Copia este archivo como .env y ajusta los valores reales.
# La app usa PostgreSQL por defecto en app/database.py.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=joinflower
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Alternativa: define una URL completa y se ignoraran las variables anteriores.
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/joinflower

# IMPORTANTE: el nombre real que lee el codigo es JWT_SECRET (app/core/security.py),
# no JWT_SECRET_KEY. Si se configura con el nombre equivocado, la app cae en el
# default inseguro hardcodeado en el codigo sin avisar. Ver pendientes/Mejoras/
# jwt-secret-produccion-sin-configurar.md para el hallazgo detallado.
JWT_SECRET=change-this-secret
# IMPORTANTE: la instancia de Cloud SQL de produccion (tier db-f1-micro) solo
# soporta max_connections=25 en Postgres. Con Cloud Run escalando hasta
# maxScale=10 instancias, cada una con su propio pool, hay que multiplicar
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x num_instancias y que quede bien por
# debajo de 25 (dejando margen para cloudsqladmin y conexiones manuales).
# Valores anteriores (8+4=12 por instancia) permitian hasta 120 conexiones
# teoricas y causaban "QueuePool limit reached" en rafagas de trafico reales
# (ver pendientes/Mejoras/pool-conexiones-agotado.md). No subir esto sin
# antes subir el tier de Cloud SQL o agregar PgBouncer.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# Cache (app/services/cache.py) - fase 1: solo memoria, Redis-ready para fase 2.
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL=300
CACHE_DEBUG=false
# Overrides opcionales por cache (segundos). Si no se definen, usan CACHE_DEFAULT_TTL.
# CACHE_TTL_BARRIOS=300
# CACHE_TTL_CATALOGO=300
# CACHE_TTL_EMPRESA_CONFIG=300

# Rate limiting (app/middlewares/rate_limit.py) - fase 1: memoria por instancia, Redis-ready para fase 2.
# Cloud Run del servicio join-flower escala hasta maxScale=10, por eso el limite de login
# se bajo de 30/minute a 10/minute (10 instancias x 30/min = 300/min efectivos era demasiado).
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
# Overrides opcionales (formato "N/minute"). Si no se definen, usan el default en el codigo.
# RATE_LIMIT_PEDIDOS_LIST=100/minute
# RATE_LIMIT_PEDIDO_CHECKOUT=60/minute
# RATE_LIMIT_PEDIDO_MANUAL=60/minute
# RATE_LIMIT_PEDIDO_CREAR=60/minute

# Webhook de WhatsApp (Meta Cloud API) - app/routers/webhooks.py
# WHATSAPP_VERIFY_TOKEN: cualquier cadena que tu elijas. Debe coincidir exactamente con el
# "Verify token" que configures en Meta App Dashboard > WhatsApp > Configuration. Se usa
# solo para el handshake GET /webhooks/whatsapp la primera vez que activas el webhook.
# WHATSAPP_APP_SECRET: el "App secret" de Meta App Dashboard > Settings > Basic. Se usa para
# validar la firma (header X-Hub-Signature-256) de cada evento POST entrante -- sin esto
# configurado, la app ACEPTA eventos sin verificar quien los mando (solo aceptable en dev).
WHATSAPP_VERIFY_TOKEN=change-this-token
WHATSAPP_APP_SECRET=change-me

# Notificacion saliente de WhatsApp al marcar un pedido ENTREGADO (Meta Cloud API) -
# app/services/whatsapp_client.py, app/services/whatsapp_service.py, app/jobs/whatsapp_dispatch_job.py.
# Ver pendientes/Mejoras/whatsapp-notificacion-entregado-decisiones.md para el diseno completo.
# META_WHATSAPP_ACCESS_TOKEN / META_WHATSAPP_PHONE_NUMBER_ID: de Meta App Dashboard (WhatsApp > API Setup).
# Mientras no esten configurados, el envio falla de forma controlada (queda como FAILED en
# la tabla whatsapp_notificacion) sin afectar la confirmacion de entrega -- se puede
# desplegar este codigo antes de tener credenciales reales de Meta, sin riesgo.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v25.0
# Nombre de la plantilla aprobada por Meta para este evento.
WHATSAPP_TEMPLATE_PEDIDO_ENTREGADO=pedidoentregado
WHATSAPP_TEMPLATE_IDIOMA=es_CO
# Cuantas veces reintentar un fallo transitorio (429/5xx/timeout) antes de marcar FAILED definitivo.
WHATSAPP_MAX_INTENTOS=3
# Job de despacho en segundo plano (app/jobs/whatsapp_dispatch_job.py) - mismo patron que
# PRODUCCION_AUTOASSIGN_ENABLED, pero corre cada N segundos en vez de a horas fijas.
WHATSAPP_DISPATCH_ENABLED=1
WHATSAPP_DISPATCH_INTERVAL_SECONDS=30
WHATSAPP_DISPATCH_BATCH_SIZE=20
